# Repeat the shared-harness comparison, alternating execution order.
foreach(required BENCH INPUT OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(NOT DEFINED CPU)
    set(CPU 2)
endif()
find_program(TASKSET taskset REQUIRED)
file(SHA256 "${INPUT}" input_hash)
file(WRITE "${OUTPUT}.metadata.txt" "input_sha256=${input_hash}\nCPU=${CPU}\nminimum_symbols=16777216\nrounds=5; alternating order; each cell is seven-sample median\nBENCH=${BENCH}\n")
file(WRITE "${OUTPUT}" "round,distribution,symbols,codec,payload_bytes,bits_per_symbol,encode_ns_per_symbol,decode_ns_per_symbol,encode_ns_per_block,decode_ns_per_block\n")
foreach(round RANGE 1 5)
    math(EXPR odd "${round} % 2")
    if(odd)
        set(order log_dc24_4 rans64_upstream_style_4)
    else()
        set(order rans64_upstream_style_4 log_dc24_4)
    endif()
    foreach(codec IN LISTS order)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env "DC_BENCH_CODEC=${codec}"
            DC_BENCH_MIN_SYMBOLS=16777216 "${TASKSET}" -c "${CPU}" "${BENCH}" --file "${INPUT}"
            RESULT_VARIABLE status OUTPUT_VARIABLE csv ERROR_VARIABLE errors)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "${codec} failed: ${errors}")
        endif()
        string(REGEX MATCH "[^\n]*,${codec},[^\n]*" row "${csv}")
        if(row STREQUAL "")
            message(FATAL_ERROR "Missing measured row for ${codec}")
        endif()
        file(APPEND "${OUTPUT}" "${round},${row}\n")
    endforeach()
endforeach()
message(STATUS "Five alternating pairs recorded in ${OUTPUT}")
