# Linux reproduction of the pinned upstream Makefile, with binaries/logs outside
# its checkout. No source patching, macro entry-point renaming, or timer changes.
foreach(required UPSTREAM OUTPUT_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(NOT DEFINED CXX)
    find_program(CXX g++ REQUIRED)
endif()
if(NOT DEFINED CPU)
    set(CPU 2)
endif()
find_program(TASKSET taskset REQUIRED)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
# This also verifies all three source hashes before building any original demo.
set(OUTPUT "${OUTPUT_DIR}/upstream_loops.generated.h")
include("${CMAKE_CURRENT_LIST_DIR}/extract_upstream.cmake")
file(SHA256 "${UPSTREAM}/book1" input_hash)
file(WRITE "${OUTPUT_DIR}/environment.txt" "upstream=c9d162d996fd600315af9ae8eb89d832576cb32d\nCPU=${CPU}\nbook1_sha256=${input_hash}\nflags=-O3 (-msse4.1 for SIMD); assertions enabled\n")
execute_process(COMMAND "${CXX}" --version OUTPUT_VARIABLE compiler RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Compiler unavailable")
endif()
file(APPEND "${OUTPUT_DIR}/environment.txt" "${compiler}")
foreach(kind byte rans64 simd)
    set(flags -O3)
    set(expected_checks 2)
    if(kind STREQUAL "byte")
        set(source main.cpp)
    elseif(kind STREQUAL "rans64")
        set(source main64.cpp)
    else()
        set(source main_simd.cpp)
        list(APPEND flags -msse4.1)
        set(expected_checks 3)
    endif()
    execute_process(COMMAND "${CXX}" ${flags} "${UPSTREAM}/${source}" -o "${OUTPUT_DIR}/${kind}" -lm -lrt
        RESULT_VARIABLE status ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Original ${kind} build failed: ${errors}")
    endif()
    set(run "${OUTPUT_DIR}/${kind}")
    if(NOT CPU STREQUAL "none")
        list(PREPEND run "${TASKSET}" -c "${CPU}")
    endif()
    execute_process(COMMAND ${run}
        WORKING_DIRECTORY "${UPSTREAM}" RESULT_VARIABLE status
        OUTPUT_FILE "${OUTPUT_DIR}/${kind}.txt" ERROR_VARIABLE errors)
    file(READ "${OUTPUT_DIR}/${kind}.txt" log)
    string(REGEX MATCHALL "decode ok!" checks "${log}")
    list(LENGTH checks count)
    if(NOT status EQUAL 0 OR log MATCHES "ERROR" OR NOT count EQUAL expected_checks)
        message(FATAL_ERROR "Original ${kind} roundtrip failed: ${status}: ${errors}")
    endif()
    message(STATUS "Original ${kind}: ${count} roundtrips passed; ${OUTPUT_DIR}/${kind}.txt")
endforeach()
